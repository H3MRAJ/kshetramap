# MongoDB — existing local service, no new infra
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=kshetramap

# NextAuth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# First super_admin, created by `npm run seed:admin` (idempotent upsert)
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=

# Phase C (not used yet)
UPLOAD_DIR=./uploads
